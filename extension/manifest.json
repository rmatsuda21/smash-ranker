{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Smash Ranker",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://smash-ranker.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Smash Ranker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://start.gg/*",
        "https://www.start.gg/*",
        "https://hivee.jp/*",
        "https://challonge.com/*",
        "https://www.challonge.com/*",
        "https://tonamel.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
