# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real secrets.

# ─── Client (exposed to the browser via Vite) ────────────────────────────────

# start.gg personal access token. Required for loading tournaments from
# start.gg in the Top 8 and Prediction tools.
# Get one at: https://start.gg/admin/profile/developer
VITE_START_GG_TOKEN=

# start.gg OAuth application id ("Log in with start.gg"). Optional: without
# it the login button is hidden. Create an application at
# https://start.gg/admin/profile/developer/applications and register
# `<origin>/oauth/callback` as its redirect URI. start.gg does not accept
# localhost, so locally that is
# https://local.smash-ranker.app:5173/oauth/callback: point that name at
# 127.0.0.1 (/etc/hosts) and run `bun run dev:https`. Browsers force https on
# every .app domain and allow no certificate exceptions there, so that script
# needs a certificate your machine trusts, made once with mkcert:
#   brew install mkcert && mkcert -install
#   mkdir -p .certs && mkcert -cert-file .certs/dev.pem -key-file .certs/dev-key.pem local.smash-ranker.app localhost Also read server-side by `api/auth.ts`.
VITE_START_GG_CLIENT_ID=

# ─── Server (used by Vercel serverless functions in `api/`) ──────────────────

# start.gg OAuth application secret. Required for login, together with
# VITE_START_GG_CLIENT_ID above.
START_GG_OAUTH_SECRET=

# Challonge API v1 key. Required only if you're working on Challonge support.
# Get one at: https://challonge.com/settings/developer
CHALLONGE_API_KEY=

# Vercel feature-flags backing value. Optional in local dev — when unset,
# `api/flags.ts` falls back to the defaults defined in the file. New flags
# default to ON in dev (`import.meta.env.DEV`) and OFF in prod.
# FLAGS=
